services:
  plex:
    image: lscr.io/linuxserver/plex:latest
    container_name: plex
    network_mode: host
    environment:
      PUID: "{{ plex_puid }}"
      PGID: "{{ plex_pgid }}"
      TZ: "{{ plex_timezone }}"
      VERSION: docker
    volumes:
      - "{{ plex_config_dir }}:/config"
      - "{{ plex_transcode_dir }}:/transcode"
      - "{{ plex_media_dir }}:/media:ro"
    restart: unless-stopped
